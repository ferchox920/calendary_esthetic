# Local development. Copy to .env and replace the placeholder secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5546
POSTGRES_USER=calendary_dev
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DATABASE=calendary_esthetic_dev
POSTGRES_SCHEMA=public
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# JWT_SECRET is the only signing/verification secret.
JWT_SECRET=replace-with-random-secret
JWT_EXPIRATION_TIME=1h
APP_ORIGIN=http://127.0.0.1:3000
# Used exclusively by the provisioning/recovery CLI, never by HTTP registration.
OWNER_EMAIL=gabriela@example.test
OWNER_PASSWORD=replace-with-generated-password
ADMIN_KEY=replace-with-random-admin-key
# No delivery, OTP logging or personal data logging in disabled mode.
EMAIL_MODE=disabled
EMAIL_NODEMAIL=
TOKEN_GMAIL=
# Configure a Google Cloud web OAuth client before enabling. Never commit real secrets.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/google/callback
# Independent, persistent AES-256 key: 32 random bytes encoded as base64.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SYNC_WORKER_ENABLED=true
# Reminder engine only. No WhatsApp adapter in this stage.
REMINDERS_WORKER_ENABLED=false
# disabled by default; simulated is restricted to development/test and sends no messages.
REMINDERS_PROVIDER=disabled
